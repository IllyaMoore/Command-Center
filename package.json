{
  "name": "command-center",
  "version": "1.0.0",
  "description": "Command Center - Personal AI assistant based on NanoClaw",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:agent-runner && npm run build:dashboard",
    "build:agent-runner": "cd container/agent-runner && npm ci && npm run build",
    "build:dashboard": "cd dashboard-next && npm ci && npm run build && cp -r out/. ../dashboard/",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/whatsapp-auth.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "setup:tasks": "tsx src/setup-tasks.ts",
    "setup:legal": "tsx src/setup-legal.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "better-sqlite3": "11.10.0",
    "busboy": "^1.6.0",
    "cron-parser": "5.5.0",
    "googleapis": "144.0.0",
    "grammy": "1.41.1",
    "pino": "9.14.0",
    "pino-pretty": "13.1.3",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/node": "22.19.11",
    "@types/qrcode-terminal": "0.12.2",
    "@vitest/coverage-v8": "4.0.18",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
